<?xml version="1.0" encoding="utf-8"?>
<!-- The file transfer screens: a header, then a scrolling column that FilePage fills with rows -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_root"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/home_top_bar_height"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/page_back"
            android:layout_width="@dimen/home_header_action_size"
            android:layout_height="@dimen/home_header_action_size"
            android:background="@drawable/bg_home_circle_button"
            android:contentDescription="@string/home_action_back"
            android:focusable="true"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_axi_back" />

        <!-- Shrinks on narrow screens before it gets cut off -->
        <TextView
            android:id="@+id/page_title"
            android:layout_width="0dp"
            android:layout_height="@dimen/home_header_action_size"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeMinTextSize="13sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/home_primary_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/page_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/page_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp" />
    </ScrollView>
</LinearLayout>
